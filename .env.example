# ── متغيرات بيئة Supabase (التطبيق) ──────────────────────────────
# انسخ هذا الملف إلى `.env` وعبّئ القيم التالية من لوحة تحكم Supabase.
#
# ملاحظة: هذه المفاتيح من نوع "publishable / anon" وهي آمنة للاستخدام العام
# في الواجهات الأمامية. لا تضع أبداً مفاتيح service_role في هذا الملف.

# معرف مشروع Supabase (يوضح في إعدادات المشروع Settings → General)
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"

# مفتاح anon/publishable (إعدادات المشروع → API)
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIs..."

# رابط المشروع (Settings → API → Project URL)
VITE_SUPABASE_URL="https://your-supabase-project-id.supabase.co"